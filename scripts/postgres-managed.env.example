# Copy this file, replace the endpoint/password, and source it on the backend VM
# when using managed PostgreSQL such as Amazon RDS.

SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/oneahead
SPRING_DATASOURCE_USERNAME=oneahead
SPRING_DATASOURCE_PASSWORD=replace-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
